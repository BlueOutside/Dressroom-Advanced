<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/diy_expand_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="14dp"
    android:paddingEnd="18dp"
    android:paddingBottom="14dp">

    <!-- Header row: icon + title + badge + edit button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/diy_expand_icon"
            android:tag="ongoingExpandPrimaryIcon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:scaleType="centerCrop"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/diy_expand_title"
                android:tag="expandPrimary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/diy_expand_subtitle"
                android:tag="expandSecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#CCFFFFFF"
                android:textSize="12sp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/diy_expand_badge"
            android:tag="expandHeaderTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:maxLines="1"
            android:textColor="#B3FFFFFF"
            android:textSize="11sp"/>

        <ImageView
            android:id="@+id/diy_expand_edit_btn"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/diy_nowbar_btn_bg"
            android:contentDescription="Edit card"
            android:padding="6dp"
            android:scaleType="fitCenter"/>
    </LinearLayout>

    <!-- Large live ticking chronometer for Countdown / Stopwatch -->
    <Chronometer
        android:id="@+id/diy_expand_chrono"
        android:tag="diy_chrono"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#FFFFFFFF"
        android:textSize="26sp"
        android:textStyle="bold"
        android:visibility="gone"/>

    <!-- Body / extended description text -->
    <TextView
        android:id="@+id/diy_expand_body"
        android:tag="description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:lineSpacingExtra="2dp"
        android:maxLines="4"
        android:textColor="#E6FFFFFF"
        android:textSize="13sp"
        android:visibility="gone"/>

    <!-- Progress section (Custom optional progress, Goal tracker, Countdown progress) -->
    <LinearLayout
        android:id="@+id/diy_expand_progress_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/diy_expand_progress_label"
                android:tag="expandHeaderAppName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#CCFFFFFF"
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/diy_expand_progress_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/diy_expand_progress"
            android:tag="tintedProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="6dp"
            android:max="100"
            android:progressDrawable="@drawable/diy_nowbar_progress"/>
    </LinearLayout>

    <!-- 2x2 System Stats Grid -->
    <LinearLayout
        android:id="@+id/diy_stats_grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/diy_stat_0"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/diy_nowbar_tile_bg"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:id="@+id/diy_stat_0_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textColor="#B3FFFFFF"
                    android:textSize="11sp"/>

                <TextView
                    android:id="@+id/diy_stat_0_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#FFFFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/diy_stat_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/diy_nowbar_tile_bg"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:id="@+id/diy_stat_1_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textColor="#B3FFFFFF"
                    android:textSize="11sp"/>

                <TextView
                    android:id="@+id/diy_stat_1_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#FFFFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/diy_stats_row_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/diy_stat_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/diy_nowbar_tile_bg"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:id="@+id/diy_stat_2_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textColor="#B3FFFFFF"
                    android:textSize="11sp"/>

                <TextView
                    android:id="@+id/diy_stat_2_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#FFFFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/diy_stat_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/diy_nowbar_tile_bg"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:id="@+id/diy_stat_3_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textColor="#B3FFFFFF"
                    android:textSize="11sp"/>

                <TextView
                    android:id="@+id/diy_stat_3_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#FFFFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Interactive Checklist (up to 6 checkable rows) -->
    <LinearLayout
        android:id="@+id/diy_check_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/diy_check_row_0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/diy_nowbar_tile_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="7dp"
            android:paddingEnd="10dp"
            android:paddingBottom="7dp"
            android:visibility="gone">
            <ImageView
                android:id="@+id/diy_check_icon_0"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:scaleType="fitCenter"/>
            <TextView
                android:id="@+id/diy_check_text_0"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/diy_check_row_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:background="@drawable/diy_nowbar_tile_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="7dp"
            android:paddingEnd="10dp"
            android:paddingBottom="7dp"
            android:visibility="gone">
            <ImageView
                android:id="@+id/diy_check_icon_1"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:scaleType="fitCenter"/>
            <TextView
                android:id="@+id/diy_check_text_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/diy_check_row_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:background="@drawable/diy_nowbar_tile_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="7dp"
            android:paddingEnd="10dp"
            android:paddingBottom="7dp"
            android:visibility="gone">
            <ImageView
                android:id="@+id/diy_check_icon_2"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:scaleType="fitCenter"/>
            <TextView
                android:id="@+id/diy_check_text_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/diy_check_row_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:background="@drawable/diy_nowbar_tile_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="7dp"
            android:paddingEnd="10dp"
            android:paddingBottom="7dp"
            android:visibility="gone">
            <ImageView
                android:id="@+id/diy_check_icon_3"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:scaleType="fitCenter"/>
            <TextView
                android:id="@+id/diy_check_text_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/diy_check_row_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:background="@drawable/diy_nowbar_tile_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="7dp"
            android:paddingEnd="10dp"
            android:paddingBottom="7dp"
            android:visibility="gone">
            <ImageView
                android:id="@+id/diy_check_icon_4"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:scaleType="fitCenter"/>
            <TextView
                android:id="@+id/diy_check_text_4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/diy_check_row_5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:background="@drawable/diy_nowbar_tile_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="7dp"
            android:paddingEnd="10dp"
            android:paddingBottom="7dp"
            android:visibility="gone">
            <ImageView
                android:id="@+id/diy_check_icon_5"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:scaleType="fitCenter"/>
            <TextView
                android:id="@+id/diy_check_text_5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Quick Launcher shortcut row (up to 4 tiles) -->
    <LinearLayout
        android:id="@+id/diy_launch_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/diy_launch_0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/diy_nowbar_tile_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="8dp"
            android:visibility="gone">
            <ImageView
                android:id="@+id/diy_launch_icon_0"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:scaleType="fitCenter"/>
            <TextView
                android:id="@+id/diy_launch_label_0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="#E6FFFFFF"
                android:textSize="11sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/diy_launch_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/diy_nowbar_tile_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="8dp"
            android:visibility="gone">
            <ImageView
                android:id="@+id/diy_launch_icon_1"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:scaleType="fitCenter"/>
            <TextView
                android:id="@+id/diy_launch_label_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="#E6FFFFFF"
                android:textSize="11sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/diy_launch_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/diy_nowbar_tile_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="8dp"
            android:visibility="gone">
            <ImageView
                android:id="@+id/diy_launch_icon_2"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:scaleType="fitCenter"/>
            <TextView
                android:id="@+id/diy_launch_label_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="#E6FFFFFF"
                android:textSize="11sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/diy_launch_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/diy_nowbar_tile_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="8dp"
            android:visibility="gone">
            <ImageView
                android:id="@+id/diy_launch_icon_3"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:scaleType="fitCenter"/>
            <TextView
                android:id="@+id/diy_launch_label_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="#E6FFFFFF"
                android:textSize="11sp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Action buttons bar (tagged textButton so clicks work even on AOD) -->
    <LinearLayout
        android:id="@+id/diy_action_row"
        android:tag="textButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/diy_btn_0"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/diy_nowbar_btn_bg"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/diy_btn_1"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/diy_nowbar_btn_bg"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/diy_btn_2"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/diy_nowbar_btn_bg"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone"/>
    </LinearLayout>
</LinearLayout>
